rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'himanshu.singh120799@marwadiuniversity.ac.in' ||
        request.auth.token.email == 'admin@eventease.io' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Ping check collection & connection test
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Registrations & Digital Tickets
    match /registrations/{registrationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Check-ins Collection
    match /checkIns/{checkInId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
